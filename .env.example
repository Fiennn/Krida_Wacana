# ============================================
# KRIDA WACANA - Contoh Environment Variables
# Portal artikel SD Negeri 2 Kemutug Lor
# Salin file ini menjadi `.env` lalu isi nilainya.
# ============================================

# --- Database PostgreSQL (Neon / Postgres lain) ---
# Aplikasi ini memakai PostgreSQL, baik untuk development maupun produksi.
# Cara membuat database gratis di Neon ada di README.md (bagian "Deploy ke Vercel").
#
# Gunakan connection string LANGSUNG (tanpa "-pooler" di nama host)
# agar `prisma migrate deploy` saat build tidak gagal.
DATABASE_URL="postgresql://user:password@host.aws.neon.tech/neondb?sslmode=require"

# --- Google OAuth (opsional, untuk "Masuk dengan Google") ---
# Langkah membuatnya ada di README.md (bagian "Setup Google OAuth").
# Selama masih placeholder, login Google otomatis dinonaktifkan dan
# pengguna tetap bisa masuk dengan email + password.
GOOGLE_CLIENT_ID="ISI-CLIENT-ID-GOOGLE"
GOOGLE_CLIENT_SECRET="ISI-CLIENT-SECRET-GOOGLE"

# --- Auth.js (NextAuth v5) ---
# Buat string acak: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="ganti-dengan-string-acak-panjang-minimal-32-karakter"
# Untuk development: http://localhost:3000
# Untuk produksi isi dengan URL domain Anda, mis. https://krida-wacana.vercel.app
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# --- Vercel Blob (khusus produksi di Vercel) ---
# Di Vercel: Storage -> Blob -> Create, lalu copy token ke sini.
# Bila kosong, gambar unggahan disimpan ke folder lokal public/uploads
# (hanya cocok untuk development di komputer sendiri).
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"
