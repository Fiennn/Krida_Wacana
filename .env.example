# ============================================
# KRIDA WACANA - Contoh Environment Variables
# Portal artikel SD Negeri 2 Kemutug Lor
# Salin file ini menjadi `.env` lalu isi nilainya.
# ============================================

# --- Database (SQLite untuk development) ---
# Saat deploy ke PostgreSQL, ganti menjadi:
# DATABASE_URL="postgresql://user:password@host:5432/kridawacana?schema=public"
DATABASE_URL="file:./dev.db"

# --- Google OAuth (opsional, untuk "Masuk dengan Google") ---
# Langkah membuatnya ada di README.md (bagian "Setup Google OAuth").
# Selama masih placeholder, login Google otomatis dinonaktifkan dan
# pengguna tetap bisa masuk dengan email + password.
GOOGLE_CLIENT_ID="ISI-CLIENT-ID-GOOGLE"
GOOGLE_CLIENT_SECRET="ISI-CLIENT-SECRET-GOOGLE"

# --- Auth.js (NextAuth v5) ---
# Buat string acak: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="ganti-dengan-string-acak-panjang-minimal-32-karakter"
# Untuk development: http://localhost:3000
# Untuk produksi isi dengan URL domain Anda, mis. https://kridawacana.sch.id
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true
